[Unit]
Description=TK-ADA Singapore staging resource worker
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target
Requires=postgresql.service redis-server.service

[Service]
Type=simple
User=tt-ada
Group=tt-ada
WorkingDirectory=/opt/tt-ada-staging/current/backend
EnvironmentFile=/etc/tt-ada-staging/app.env
Environment=PYTHONUNBUFFERED=1
# 两个准备槽公平轮询准备/结果，空闲时帮助核验；另有独立结果槽保底，总槽数不变。
ExecStart=/opt/tt-ada-staging/current/.venv/bin/celery -A app.jobs.celery_app:celery_app worker -Q resources,resource-results --pool prefork --concurrency 2 --max-memory-per-child 262144 --max-tasks-per-child 100 --loglevel INFO --hostname resources-singapore@%%h
Restart=on-failure
RestartSec=5
TimeoutStopSec=960
KillMode=mixed
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/tt-ada-staging

[Install]
WantedBy=multi-user.target
