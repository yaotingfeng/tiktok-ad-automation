[Unit]
Description=TK-ADA Singapore staging resource worker
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target
Requires=postgresql.service redis-server.service

[Service]
Type=simple
User=tt-ada
Group=tt-ada
WorkingDirectory=/opt/tt-ada-staging/current/backend
EnvironmentFile=/etc/tt-ada-staging/app.env
Environment=PYTHONUNBUFFERED=1
# 素材保留两个执行槽；已就绪广告和控制任务由独立消费者处理。
ExecStart=/opt/tt-ada-staging/current/.venv/bin/celery -A app.jobs.celery_app:celery_app worker -Q resources,resource-results --pool prefork --concurrency 2 --loglevel INFO --hostname resources-singapore@%%h
Restart=on-failure
RestartSec=5
TimeoutStopSec=960
KillMode=mixed
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/tt-ada-staging

[Install]
WantedBy=multi-user.target
