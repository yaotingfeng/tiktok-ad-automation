[Unit]
Description=TK-ADA Singapore staging ads reporting worker
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target
Requires=postgresql.service redis-server.service

[Service]
Type=simple
User=tt-ada
Group=tt-ada
WorkingDirectory=/opt/tt-ada-staging/current/backend
EnvironmentFile=/etc/tt-ada-staging/app.env
Environment=PYTHONUNBUFFERED=1
# ADS_SYNC_ENABLED and quota policy are loaded from the shared EnvironmentFile.
# The worker slot remains explicitly bounded to one process below.
ExecStart=/opt/tt-ada-staging/current/.venv/bin/celery -A app.jobs.celery_app:celery_app worker -Q ads-reporting --pool prefork --concurrency 1 --loglevel INFO --hostname ads-reporting-singapore@%%h
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
KillMode=mixed
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/tt-ada-staging

[Install]
WantedBy=multi-user.target
