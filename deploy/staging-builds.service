[Unit]
Description=TK-ADA Singapore staging advertisement build worker
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target
Requires=postgresql.service redis-server.service

[Service]
Type=simple
User=tt-ada
Group=tt-ada
WorkingDirectory=/opt/tt-ada-staging/current/backend
EnvironmentFile=/etc/tt-ada-staging/app.env
Environment=PYTHONUNBUFFERED=1
# 广告创建独立执行，不会被素材共享/封面的网络等待占满。
ExecStart=/opt/tt-ada-staging/current/.venv/bin/celery -A app.jobs.celery_app:celery_app worker -Q builds --pool prefork --concurrency 1 --loglevel INFO --hostname builds-singapore@%%h
Restart=on-failure
RestartSec=5
TimeoutStopSec=960
KillMode=mixed
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/tt-ada-staging

[Install]
WantedBy=multi-user.target
