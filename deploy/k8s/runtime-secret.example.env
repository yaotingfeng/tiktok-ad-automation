# Copy this file outside Git and fill every required value.
# Use literal KEY=value (no shell quotes). Fill the assigned host and explicit
# feature flags for this environment; never copy staging queues into a second live instance.
PROJECT_NAME=TK-ADA
SECRET_KEY=
FIRST_SUPERUSER=
FIRST_SUPERUSER_PASSWORD=
DATABASE_URL=postgresql+psycopg://<user>:<password>@<postgres-host>:5432/<database>
REDIS_URL=redis://:<password>@<redis-host>:6379/0
CONNECTION_ENCRYPTION_KEY=
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_REDIRECT_URI=
TIKTOK_AUTHORIZATION_URL=
TIKTOK_CALL_POLICIES=
MCP_CLIENT_REGISTRATION_REF=/run/tk-ada/mcp-client.json
MCP_REDIRECT_URI=https://tkada.shortclipflix.com/api/integrations/tiktok/mcp/callback
MCP_SERVICE_QUOTA_SCOPE=
SENTRY_DSN=
ADS_SYNC_ENABLED=
AUTOMATED_RULES_ENABLED=
ADS_DIRECTORY_WORKER_CONCURRENCY=1
ADS_REPORTING_WORKER_CONCURRENCY=1
AD_MANAGEMENT_WORKER_CONCURRENCY=1
BC_CAPABILITY_MAX_AGE_SECONDS=86400
SCENE_MAX_AGE_SECONDS=86400
MATERIAL_SDK_MAX_UPLOAD_BYTES=268435456
MATERIAL_SDK_UPLOAD_MAX_INFLIGHT=1
MATERIAL_INGEST_ENABLED=
MATERIAL_PUSH_CLIENTS={}
MATERIAL_CLEANUP_ENABLED=
MATERIAL_URL_MAX_UPLOAD_BYTES=1073741824
MATERIAL_STORAGE_GLOBAL_BYTES=0
MATERIAL_STORAGE_TENANT_BYTES=0
MATERIAL_PART_URL_SECONDS=900
MATERIAL_INGEST_URL_SECONDS=7200
MATERIAL_VALIDATION_SECONDS=300
MATERIAL_ABANDON_SECONDS=86400
MATERIAL_REMOTE_MEDIA_HOSTS=[]
OBJECT_STORAGE_PROVIDER=r2
S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
S3_BUCKET=<private-bucket>
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
FRONTEND_HOST=https://tkada.shortclipflix.com
