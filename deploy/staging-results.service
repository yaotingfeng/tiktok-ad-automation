[Unit]
Description=TK-ADA Singapore staging material result worker
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target
Requires=postgresql.service redis-server.service

[Service]
Type=simple
User=tt-ada
Group=tt-ada
WorkingDirectory=/opt/tt-ada-staging/current/backend
EnvironmentFile=/etc/tt-ada-staging/app.env
Environment=PYTHONUNBUFFERED=1
# 专用结果槽保底；另两个共享准备/核验槽可协助，总素材槽数为三，外部额度不变。
ExecStart=/opt/tt-ada-staging/current/.venv/bin/celery -A app.jobs.celery_app:celery_app worker -Q resource-results --pool prefork --concurrency 1 --loglevel INFO --hostname results-singapore@%%h
Restart=on-failure
RestartSec=5
TimeoutStopSec=960
KillMode=mixed
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/tt-ada-staging

[Install]
WantedBy=multi-user.target
