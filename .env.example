# Copy to .env. Generate unique secrets; never commit .env.
PROJECT_NAME=TikTok Ad Automation
SECRET_KEY=
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://postgres:replace-me@127.0.0.1:55432/app
REDIS_URL=redis://127.0.0.1:56379/0
FRONTEND_HOST=http://localhost:5173
# Optional until the developer App is available.
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_REDIRECT_URI=
# Configure verified quotas before enabling external SDK calls.
TIKTOK_CALL_POLICIES={}
CONNECTION_ENCRYPTION_KEY=
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=
# HTTPS staging only; use real DNS and an accessible server.
DOMAIN=
ACME_EMAIL=
