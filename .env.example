# Shared template. Use scripts/environment.py <local|staging|production> init.
PROJECT_NAME=TK-ADA
SECRET_KEY=
FIRST_SUPERUSER=admin
FIRST_SUPERUSER_PASSWORD=
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://postgres:replace-me@127.0.0.1:55432/app
REDIS_URL=redis://127.0.0.1:56379/0
# Local outbox drain: fair rounds per control task, independent of TikTok quotas.
DISPATCH_MAX_ROUNDS=20
DISPATCH_TIME_BUDGET_SECONDS=1
FRONTEND_HOST=http://localhost:5173
# Optional until the developer App is available.
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_REDIRECT_URI=
# Official advertiser authorization URL from the developer portal.
TIKTOK_AUTHORIZATION_URL=
# Configure verified quotas before enabling external SDK calls.
TIKTOK_CALL_POLICIES={}
# Independent per-environment MCP registration file and exact OAuth callback.
MCP_CLIENT_REGISTRATION_REF=
MCP_REDIRECT_URI=
# Set only after verifying the official service quota scope; empty shares a conservative scope.
MCP_SERVICE_QUOTA_SCOPE=
SENTRY_DSN=
# Engineering capability cache (60..86400 seconds), from the first BC page.
# Size this for the BC account count and measured queue duration; not a TikTok quota.
BC_CAPABILITY_MAX_AGE_SECONDS=86400
# Engineering scene cache age from first observation (60..604800 seconds).
SCENE_MAX_AGE_SECONDS=86400
CONNECTION_ENCRYPTION_KEY=
# Engineering material limits; byte limits are not platform quotas.
MATERIAL_SDK_MAX_UPLOAD_BYTES=268435456
MATERIAL_SDK_UPLOAD_MAX_INFLIGHT=1
MATERIAL_ASSET_MAX_AGE_SECONDS=900
# Private object storage: legacy S3 is the default; R2 is explicitly selected.
OBJECT_STORAGE_PROVIDER=s3
# Independent switches remain disabled until deployment acceptance passes.
MATERIAL_INGEST_ENABLED=false
MATERIAL_CLEANUP_ENABLED=false
MATERIAL_URL_MAX_UPLOAD_BYTES=1073741824
# Reserved original bytes across all tenants / all BCs of one tenant.
MATERIAL_STORAGE_GLOBAL_BYTES=8589934592
MATERIAL_STORAGE_TENANT_BYTES=2147483648
MATERIAL_PART_URL_SECONDS=900
MATERIAL_INGEST_URL_SECONDS=7200
MATERIAL_VALIDATION_SECONDS=300
MATERIAL_ABANDON_SECONDS=86400
# JSON array of exact deployment-verified platform media hosts; no wildcards.
MATERIAL_REMOTE_MEDIA_HOSTS=[]
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# HTTPS staging only; use real DNS and an accessible server.
DOMAIN=
ACME_EMAIL=
